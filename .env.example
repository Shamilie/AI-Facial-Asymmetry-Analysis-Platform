# ==============================================================================
# AI Facial Asymmetry Analysis Platform — Environment Boot Configuration
# ==============================================================================
# Copy this template to .env on fresh deployments.
#
# Note: AI provider API keys (GEMINI_API_KEY, NVIDIA_API_KEY, OPENAI_API_KEY),
# model parameters, and runtime options are managed dynamically in the database
# via the Web Settings UI (or the system_settings table).
#
# Only core infrastructure secrets required prior to database boot belong here.
# ==============================================================================

# --- Database Connection (PostgreSQL 16 with automatic local fallback) ---
DATABASE_URL=postgresql+asyncpg://faplatform:dev_password_123@localhost:5432/facial_asymmetry
DATABASE_URL_SYNC=postgresql://faplatform:dev_password_123@localhost:5432/facial_asymmetry

# --- Application & JWT Secrets ---
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret-in-production

# --- CORS Allowed Web Origins ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Runtime Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO
