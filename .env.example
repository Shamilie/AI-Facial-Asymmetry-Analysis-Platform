# ============================================================
# AI Facial Asymmetry Analysis Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in production values.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://faplatform:dev_password_123@localhost:5432/facial_asymmetry
DATABASE_URL_SYNC=postgresql://faplatform:dev_password_123@localhost:5432/facial_asymmetry

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Binary Object Storage (database | s3 | local) ---
STORAGE_BACKEND=database
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- AI Provider Keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# --- MediaPipe ---
MEDIAPIPE_MODEL_PATH=./models/mediapipe

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
